rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Recibos ficam em receipts/{uid}/{arquivo}, exatamente o caminho que o
    // StorageService monta. Só o dono da pasta lê e escreve.
    match /receipts/{userId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // Uploads are image-only and capped at 5 MiB. MIME metadata is checked
      // here and the client also validates the extension and actual size.
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size > 0
                            && request.resource.size <= 5 * 1024 * 1024
                            && request.resource.contentType.matches(
                              'image/(jpeg|png|webp|heic)'
                            );

      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
