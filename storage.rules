rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Recibos ficam em receipts/{userId}/{fileName} (ver storage_service.dart)
    // — só o próprio usuário autenticado pode ler ou enviar os seus.
    match /receipts/{userId}/{fileName} {
      allow read, write: if request.auth != null
                          && request.auth.uid == userId;
    }
  }
}
