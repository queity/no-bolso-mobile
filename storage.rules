rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Recibos ficam em receipts/{uid}/{arquivo}, exatamente o caminho que o
    // StorageService monta. Só o dono da pasta lê e escreve.
    match /receipts/{userId}/{fileName} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
